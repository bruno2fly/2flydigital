# --- Consultation form (src/app/api/consultation/route.ts) ---

# Resend API key. Create one at https://resend.com → API Keys.
# Free tier covers 100 emails/day.
RESEND_API_KEY=

# Verified sender for the consultation email.
# In Resend, add and verify the domain (or use onboarding@resend.dev while testing).
# Format: "Display Name <address@your-verified-domain.com>"
CONSULTATION_FROM_EMAIL="2FLY Website <noreply@2flydigital.com>"
